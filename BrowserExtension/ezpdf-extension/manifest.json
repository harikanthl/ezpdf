{
    "manifest_version": 3,
    "name": "ezpdf",
    "description": "Make a clean PDF or EPUB of any page, send it to your Kindle, or pull statement and invoice data, with the ezpdf Mac app.",
    "version": "0.1.0",
    "icons": { "16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png" },
    "background": { "service_worker": "background.js", "scripts": ["background.js"] },
    "action": {
        "default_popup": "popup.html",
        "default_title": "ezpdf",
        "default_icon": { "16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png" }
    },
    "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
    "host_permissions": ["http://127.0.0.1:7337/*"],
    "commands": {
        "_execute_action": { "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" } },
        "send-to-kindle": { "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" }, "description": "Send this page to Kindle" }
    }
}
